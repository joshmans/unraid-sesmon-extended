            <input id="CLEARALERTS" class="sesext-tip" type="button" value="Clear Alerts" title="Clear all alerts from the dashboard (until the next alert populates it again).">
            <input id="CLEARDEVICES" class="sesext-tip" type="button" value="Clear Devices" title="Clear all devices from the dashboard (until next poll populates it again).">
        </dt>
        <dd>
            <span>
                <input type="submit" name="#apply" value="Apply">
                <input type="button" value="Done" onclick="done()">
                <input id="DEFAULT2" type="submit" class="sesext-tip" name="#default" value="Default" title="Revert the displayed settings to their default values, but not the program configuration.">
            </span>
        </dd>
    </dl>
</form>

<script>
try {
    function sesextRunning() {
        if ($('#SERVICE').val() === 'enable') {
            $('#sesext-set-cmd').val('/usr/local/emhttp/plugins/sesmon-ext/scripts/start');
        } else {
            $('#sesext-set-cmd').val('/usr/local/emhttp/plugins/sesmon-ext/scripts/stop');
        }

        const sesext_running = <?= json_encode($sesext_running); ?>;

        if (sesext_running) {
            $('.sesext-run').prop('disabled', true);
            $('.sesext-notrun').prop('disabled', false);
        } else {
            $('.sesext-run').prop('disabled', false);
            $('.sesext-notrun').prop('disabled', true);
        }
    }

    function sesextResetConfig() {
        $('#sesext-set-cmd').val('');
        openBox('/plugins/sesmon-ext/scripts/resetconf', 'sesmon Configuration Reset', 600, 600, true);
    }
    $(function() {
        showStatus('sesmon');
        sesextRunning();

        $('#SERVICE').change(sesextRunning);

        $('#RESETCONF').click(function(){ swal({title:"Are you sure?",text:"This action will return any existing configuration to their defaults!",type:"warning",html:true,showCancelButton:true}, sesextResetConfig); });

        $('#CLEARDEVICES').click(function(){
            $('#sesext-display-set-cmd').val('/usr/local/emhttp/plugins/sesmon-ext/scripts/clear_devices');
            $('#sesext-display-settings').submit();
        });

        $('#CLEARALERTS').click(function(){
            $('#sesext-display-set-cmd').val('/usr/local/emhttp/plugins/sesmon-ext/scripts/clear_alerts');
            $('#sesext-display-settings').submit();
        });

        $('#RESTART').click(function(){
            $('#sesext-set-cmd').val('/usr/local/emhttp/plugins/sesmon-ext/scripts/restart');
            $('#sesext-settings').submit();
        });

        $('.sesext-tip').tooltipster({
            maxWidth: 300
        });

        if ( typeof caPluginUpdateCheck === "function" ) {
            caPluginUpdateCheck("sesmon-ext.plg",{name:"SCSI Enclosure Monitor"});
        }
    });
} catch (error) {
    console.error('dwesmon settings error:', error);
}
</script>
