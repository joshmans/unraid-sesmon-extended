<form markdown="0" id="sesext-display-settings" name="sesext_display_settings" method="POST" action="/update.php" target="progressFrame">
    <input type="hidden" id="sesext-display-set-file" name="#file" value="sesmon-ext/sesmon-ext.cfg">
    <input type="hidden" id="sesext-display-set-cmd" name="#command" value="/usr/local/emhttp/plugins/sesmon-ext/scripts/write_config">

    <dl>
        <dt>Frontpage Dashboards:</dt>
        <dd>
            <select id="DASHBOARDS" name="DASHBOARDS" size="1">
                <?=mk_option($sesext_dashboards, "disable", "No");?>
                <?=mk_option($sesext_dashboards, "enable", "Yes");?>
            </select>
        </dd>
