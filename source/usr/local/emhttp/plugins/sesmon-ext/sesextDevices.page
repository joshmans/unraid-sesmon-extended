<div id="sesext-content"></div>

<script src="<?=autov('/plugins/sesmon-ext/js/sesext_friendly.js');?>"></script>
<script>
try {
    function sesext_safe(val) {
        return (val !== undefined && val !== null) ? val : '';
    }

    // Friendly shows names and plain words (see js/sesext_friendly.js); Raw shows the values as sesmon reports them
    var sesext_view = 'friendly';
    try { var sesext_saved = localStorage.getItem('sesext_view'); if (sesext_saved === 'raw' || sesext_saved === 'friendly') { sesext_view = sesext_saved; } } catch (e) {}
    var sesext_unit = 'C';   // temperatures in Celsius (as reported) or Fahrenheit; only the Friendly view converts
    try { var sesext_savedUnit = localStorage.getItem('sesext_unit'); if (sesext_savedUnit === 'C' || sesext_savedUnit === 'F') { sesext_unit = sesext_savedUnit; } } catch (e) {}
    var sesext_last = null;

    function sesext_esc(s) {
        return String(s === undefined || s === null ? '' : s).replace(/[&<>"']/g, function (c) { return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c]; });
    }
    function sesext_pill(st) {
        return st ? '<span class="' + st.cls + '" title="' + sesext_esc(st.tip) + '">' + sesext_esc(st.label) + '</span>' : '';
    }
    function sesext_chips(list) {
        return list.map(function (f) { return '<span class="sesext-chip" title="' + sesext_esc(f.tip) + '">' + sesext_esc(f.label) + '</span>'; }).join('');
    }
    function sesext_friendlySummary(counts) {
        return SesextFriendly.summarize(counts).map(function (x) { return '<span class="' + x.cls + '">' + x.n + ' ' + sesext_esc(x.label) + '</span>'; });
    }
    // the drive(s) in a bay: the physical drive once for a dual-disk bay, then each disk (linked to its Unraid page)
    function sesext_driveCell(d) {
        if (!d) { return ''; }
        var h = '';
        if (d.head) { h += '<div class="sesext-drive-head">' + sesext_esc(d.head) + '</div>'; }
        d.lines.forEach(function (l) {
            h += '<div class="sesext-drive-line" title="' + sesext_esc(l.tip) + '">' +
                 (l.url ? '<a href="' + sesext_esc(l.url) + '">' + sesext_esc(l.name) + '</a>' : '<strong>' + sesext_esc(l.name) + '</strong>') +
                 (l.text ? ' \u00b7 ' + sesext_esc(l.text) : '') + '</div>';
        });
        if (d.lastKnown) { h += '<div class="sesext-note">last known: this drive is no longer seen by the server</div>'; }
        return h;
    }
    function sesext_hbaText(bayInfo) {
        var h = bayInfo && bayInfo.hba;
        return h ? 'HBA ' + sesext_esc(h.name) + ', firmware ' + sesext_esc(h.firmware) + ' - ' : '';
    }
    // the elements, grouped by kind, with names, status words, drives, readings and notes
    function sesext_friendlyTable(fr) {
        var cols = fr.hasDrives ? 5 : 4;
        var h = '<table class="sesext-elements-table tablesorter"><thead><tr><th>Component</th><th>Status</th>' + (fr.hasDrives ? '<th>Drive</th>' : '') + '<th>Reading</th><th>Notes</th></tr></thead><tbody>';
        fr.groups.forEach(function (g) {
            h += '<tr class="sesext-group-row"><td colspan="' + cols + '">' + sesext_esc(g.title) + '<span class="sesext-status-summary">' + sesext_friendlySummary(g.counts).join(' | ') + '</span></td></tr>';
            g.items.forEach(function (i) {
                var notes = sesext_chips(i.flags) + (i.linked ? '<span class="sesext-tag" title="What is at the far end of this port\'s cable">cabled to ' + sesext_esc(i.linked) + '</span>' : '');
                h += '<tr><td title="Element ' + sesext_esc(i.id) + '">' + sesext_esc(i.name) + '</td><td>' + sesext_pill(i.status) + '</td>' + (fr.hasDrives ? '<td>' + sesext_driveCell(i.drive) + '</td>' : '') + '<td>' + sesext_esc(i.reading) + '</td><td>' + notes + '</td></tr>';
            });
        });
        h += '</tbody></table>';
        if (fr.hidden > 0) {
            h += '<div class="sesext-note">' + fr.hidden + ' overall entries that this enclosure does not report are hidden. Switch to Raw to see every element.</div>';
        }
        return h;
    }
    // one alert (the changes sesmon detected), before and after in words
    function sesext_friendlyAlert(alertData, ctx) {
        var described = [];
        $.each(alertData.changes, function (i, change) { if (change) { described.push({change: change, d: SesextFriendly.describeChange(change, sesext_unit, ctx)}); } });
        var withDrives = described.some(function (x) { return !!x.d.drive; });
        var h = '<table class="sesext-alert-file-table tablesorter"><thead>';
        h += '<tr class="sesext-alert-file-header"><th colspan="' + (withDrives ? 6 : 5) + '"><strong>Change Detected:</strong> ' + sesext_esc(sesext_formatDate(sesext_safe(alertData.detected_at))) + ' ' + sesext_getTimeAgo(alertData.detected_at, false) + '</th></tr>';
        h += '<tr><th>Component</th><th>Before</th><th>After</th>' + (withDrives ? '<th>Drive</th>' : '') + '<th>Reading</th><th>Notes</th></tr></thead><tbody>';
        $.each(described, function (i, x) {
            var change = x.change, d = x.d;
            var notes = sesext_chips(d.flags);
            if (d.flagsBefore.length) { notes += ' <span class="sesext-note">(before: ' + sesext_esc(d.flagsBefore.map(function (f) { return f.label; }).join(', ')) + ')</span>'; }
            h += '<tr class="alert-change-row"><td title="Element ' + sesext_esc(change.id) + '">' + sesext_esc(d.name) + '</td><td>' + (d.before ? sesext_pill(d.before) : '<span class="sesext-note">new</span>') +
                 '</td><td>' + (d.after ? sesext_pill(d.after) : '<span class="sesext-note">gone</span>') + '</td>' + (withDrives ? '<td>' + sesext_driveCell(d.drive) + '</td>' : '') + '<td>' + sesext_esc(d.reading) + '</td><td>' + notes + '</td></tr>';
        });
        return h + '</tbody></table>';
    }

    function sesext_formatDate(date) {
        if (!date) return '';

        const dateObj = new Date(date);
        return isNaN(dateObj.getTime()) ? '' : dateObj.toLocaleString();
    }

    function sesext_sortElementId(a, b) {
        var parseId = function(id) {
            var parts = id.split('#');
            return [parseInt(parts[0]), parseInt(parts[1])];
        };

        var aParts = parseId(a);
        var bParts = parseId(b);

        if (aParts[0] !== bParts[0]) {
            return aParts[0] - bParts[0];
        }
        return aParts[1] - bParts[1];
    }

    function sesext_getTimeAgo(timestamp, withColor) {
        if (timestamp == undefined || timestamp == null) return '';

        var then = new Date(timestamp);
        if (isNaN(then.getTime())) {
            return '';
        }

        var now = new Date();
        var diffMs = now - then;
        var diffMins = Math.floor(diffMs / 60000);

        var isStale = diffMins > 10;
        var timeClass = isStale ? 'sesext-time-stale' : 'sesext-time-ok';

        var timeText = '';
        if (diffMins < 1) {
            timeText = 'just now';
        } else if (diffMins < 60) {
            timeText = diffMins + ' min ago';
        } else {
            var hours = Math.floor(diffMins / 60);
            timeText = hours + ' hour' + (hours > 1 ? 's' : '') + ' ago';
        }

        if (withColor) {
            return '<span class="sesext-time-ago ' + timeClass + '">(' + timeText + ')</span>';
        } else {
            return '<span class="sesext-time-ago">(' + timeText + ')</span>';
        }
    }

    function sesext_getStatusClass(status) {
        if (status == undefined || status == null) return '';

        var s = Number(status);
        if (s === 1) return 'sesext-status-ok';
        else if (s === 2) return 'sesext-status-critical';
        else if (s === 3) return 'sesext-status-noncritical';
        else if (s === 4) return 'sesext-status-unrecoverable';
        else if (s === 0) return 'sesext-status-unsupported';
        else if (s === 5) return 'sesext-status-not-installed';
        else if (s === 6) return 'sesext-status-unknown';
        else if (s === 7) return 'sesext-status-not-available';

        return '';
    }

    function sesext_toggleChevron(targetId) {
        var chevronId = targetId + '-chevron';

        if ($(targetId).is(':visible')) {
            $(chevronId).removeClass("fa-chevron-right").addClass("fa-chevron-down");
        } else {
            $(chevronId).removeClass("fa-chevron-down").addClass("fa-chevron-right");
        }
    }

    function sesext_buildDevice(folderName, data, alertDataArray, targetContainer, bayInfo) {
        var ctx = bayInfo ? {bays: bayInfo.bays} : null; // the bays named by their drives (see include/sesext_bays.php)
        var html = '';

        data = data || {};
        data.device = data.device || {};
        data.raw = data.raw || {};

        var deviceContentId = 'sesext-content-' + folderName;
        var alertSectionId = 'sesext-alerts-' + folderName;
        var elementsSectionId = 'sesext-elements-' + folderName;

        // Alerts section status counts (do this here because device section needs it)
        var totalAlerts = 0;
        var alertCounts = {2: 0, 3: 0, 4: 0, 1: 0, other: 0};
        $.each(alertDataArray, function(idx, alertData) {
            if (!alertData || !Array.isArray(alertData.changes)) {
                return;
            }

            totalAlerts += alertData.changes.length;

            $.each(alertData.changes, function(changeIdx, change) {
                if (!change || !change.after) return;

                var status = Number(change.after.status);

                if (status === 2) alertCounts[2]++;
                else if (status === 3) alertCounts[3]++;
                else if (status === 4) alertCounts[4]++;
                else if (status === 1) alertCounts[1]++;
                else alertCounts.other++;
            });
        });

        // Device section status counts
        var statusCounts = {1: 0, 2: 0, 3: 0, 4: 0, other: 0};
        $.each(data.raw, function(elementId, element) {
                if (!element || element.status === undefined || element.status === null) return;

            var status = Number(element.status);
            if (status in statusCounts) {
                statusCounts[status]++;
            } else {
                statusCounts.other++;
            }
        });

        var deviceSummary = [];
        if (totalAlerts > 0) deviceSummary.push('<span class="sesext-alert-count">' + totalAlerts + ' Alert' + (totalAlerts > 1 ? 's' : '') + '</span>');
        if (statusCounts[2] > 0) deviceSummary.push('<span class="sesext-status-critical">' + statusCounts[2] + ' Critical</span>');
        if (statusCounts[3] > 0) deviceSummary.push('<span class="sesext-status-noncritical">' + statusCounts[3] + ' Noncritical</span>');
        if (statusCounts[4] > 0) deviceSummary.push('<span class="sesext-status-unrecoverable">' + statusCounts[4] + ' Unrecoverable</span>');
        if (statusCounts[1] > 0) deviceSummary.push('<span class="sesext-status-ok">' + statusCounts[1] + ' OK</span>');
        if (statusCounts.other > 0) deviceSummary.push('<span class="sesext-status-other">' + statusCounts.other + ' Other</span>');

        var fr = sesext_view === 'friendly' ? SesextFriendly.group(data.raw, sesext_unit, ctx) : null;
        if (fr) {
            deviceSummary = [];
            if (totalAlerts > 0) deviceSummary.push('<span class="sesext-alert-count">' + totalAlerts + ' Alert' + (totalAlerts > 1 ? 's' : '') + '</span>');
            deviceSummary = deviceSummary.concat(sesext_friendlySummary(fr.counts));
        }

        var alertTimeHtml = '';
        if (alertDataArray.length > 0) {
            alertDataArray.sort(function(a, b) {
                return new Date(b.detected_at) - new Date(a.detected_at);
            });
            alertTimeHtml = ' - Alert: ' + sesext_formatDate(alertDataArray[0].detected_at) + ' ' + sesext_getTimeAgo(alertDataArray[0].detected_at, true);
        }

        // Device section header
        html += '<div class="sesext-device-section-header" data-toggle-id="' + deviceContentId + '" style="cursor: pointer;">';
        html += '<i class="fa fa-chevron-right" id="'+ deviceContentId +'-chevron"></i> ';
        html += (sesext_safe(data.device.description) || folderName) + ' ';
        html += '(' + sesext_safe(data.device.path) + ':' + sesext_safe(data.device.address) + ') - ';
        html += sesext_hbaText(bayInfo);
        html += 'Updated: ' + sesext_formatDate(sesext_safe(data.captured_at)) + ' ' + sesext_getTimeAgo(data.captured_at, true) + alertTimeHtml;
        html += '<span class="sesext-status-summary">' + deviceSummary.join(' | ') + '</span>';
        html += '</div>';

        html += '<div id="' + deviceContentId + '" class="sesext-device-content">';

        // Alerts Section
        if (alertDataArray.length > 0) {
            var alertSummary = [];
            if (alertCounts[2] > 0) alertSummary.push('<span class="sesext-status-critical">' + alertCounts[2] + ' Critical</span>');
            if (alertCounts[3] > 0) alertSummary.push('<span class="sesext-status-noncritical">' + alertCounts[3] + (fr ? ' Warning' : ' Noncritical') + '</span>');
            if (alertCounts[4] > 0) alertSummary.push('<span class="sesext-status-unrecoverable">' + alertCounts[4] + (fr ? ' Failed' : ' Unrecoverable') + '</span>');
            if (alertCounts[1] > 0) alertSummary.push('<span class="sesext-status-ok">' + alertCounts[1] + ' OK</span>');
            if (alertCounts.other > 0) alertSummary.push('<span class="sesext-status-other">' + alertCounts.other + ' Other</span>');

            // Alerts section header
            html += '<div class="sesext-alert-section-header">';
            html += '<strong>ALERTS</strong> <span class="sesext-status-summary">' + alertSummary.join(' | ') + '</span>';
            html += '</div>';

            // Alerts section tables (one per alert)
            $.each(alertDataArray, function(idx, alertData) {
                if (!alertData || !Array.isArray(alertData.changes)) return;
                if (fr) { html += sesext_friendlyAlert(alertData, ctx); return; }

                // Alert table header
                html += '<table class="sesext-alert-file-table tablesorter"><thead>';
                html += '<tr class="sesext-alert-file-header"><th colspan="10">';
                html += '<strong>Change Detected:</strong> ' + sesext_formatDate(sesext_safe(alertData.detected_at)) + ' ' + sesext_getTimeAgo(alertData.detected_at, false);
                html += '</th></tr>';
                html += '<tr>';
                html += '<th>Element ID</th><th>Description</th><th>Before Status</th><th>Before Desc</th><th>Before Flags</th>';
                html += '<th>Before Extra</th><th>After Status</th><th>After Desc</th><th>After Flags</th><th>After Extra</th></tr>';
                html += '</thead><tbody>';

                // Alert table rows (one per change)
                $.each(alertData.changes, function(changeIdx, change) {
                    if (!change) return;

                    var before = change.before || {};
                    var after  = change.after  || {};

                    var before_extra = [];
                    if (before.temperature) before_extra.push('Temp: ' + before.temperature);
                    if (before.voltage) before_extra.push('Volt: ' + before.voltage + 'V');
                    if (before.amperage) before_extra.push('Amp: ' + before.amperage + 'A');

                    var after_extra = [];
                    if (after.temperature) after_extra.push('Temp: ' + after.temperature);
                    if (after.voltage) after_extra.push('Volt: ' + after.voltage + 'V');
                    if (after.amperage) after_extra.push('Amp: ' + after.amperage + 'A');

                    html += '<tr class="alert-change-row">';
                    html += '<td>' + sesext_safe(change.id) + '</td><td>' + sesext_safe(change.element_type_desc) + '</td>';
                    html += '<td>' + sesext_safe(before.status) + '</td>';
                    html += '<td class="' + sesext_getStatusClass(before.status) + '">' + sesext_safe(before.status_desc) + '</td>';
                    html += '<td>P:' + sesext_safe(before.prdfail) + ' D:' + sesext_safe(before.disabled) + ' S:' + sesext_safe(before.swap) + '</td>';
                    html += '<td>' + before_extra.join(', ') + '</td>';
                    html += '<td>' + sesext_safe(after.status) + '</td>';
                    html += '<td class="' + sesext_getStatusClass(after.status) + '">' + sesext_safe(after.status_desc) + '</td>';
                    html += '<td>P:' + sesext_safe(after.prdfail) + ' D:' + sesext_safe(after.disabled) + ' S:' + sesext_safe(after.swap) + '</td>';
                    html += '<td>' + after_extra.join(', ') + '</td>';
                    html += '</tr>';
                });

                html += '</tbody></table>';
            });
        }

        // Elements section status counts
        var elementSummary = [];
        if (statusCounts[2] > 0) elementSummary.push('<span class="sesext-status-critical">' + statusCounts[2] + ' Critical</span>');
        if (statusCounts[3] > 0) elementSummary.push('<span class="sesext-status-noncritical">' + statusCounts[3] + ' Noncritical</span>');
        if (statusCounts[4] > 0) elementSummary.push('<span class="sesext-status-unrecoverable">' + statusCounts[4] + ' Unrecoverable</span>');
        if (statusCounts[1] > 0) elementSummary.push('<span class="sesext-status-ok">' + statusCounts[1] + ' OK</span>');
        if (statusCounts.other > 0) elementSummary.push('<span class="sesext-status-other">' + statusCounts.other + ' Other</span>');

        // Elements sections header
        html += '<div class="sesext-elements-section-header">';
        if (fr) { elementSummary = sesext_friendlySummary(fr.counts); }
        html += '<strong>ELEMENTS</strong> <span class="sesext-status-summary">' + elementSummary.join(' | ') + '</span>';
        html += '</div>';

        if (fr) {
            html += sesext_friendlyTable(fr) + '</div><br>';
        } else {
            // Elements table
            html += '<table class="sesext-elements-table tablesorter"><thead>';

            // Elements table header
            html += '<tr>';
            html += '<th>Element ID</th><th>Description</th><th>Status</th><th>Status Desc</th>';
            html += '<th>Prdfail</th><th>Disabled</th><th>Swap</th><th>Extra</th></tr>';
            html += '</thead><tbody>';

            // Elements table rows
            var sortedKeys = Object.keys(data.raw).sort(sesext_sortElementId);
            $.each(sortedKeys, function(index, elementId) {
                var element = data.raw[elementId];
                if (!element) return;

                var extra = [];
                if (element.temperature) extra.push('Temp: ' + element.temperature);
                if (element.voltage) extra.push('Volt: ' + element.voltage + 'V');
                if (element.amperage) extra.push('Amp: ' + element.amperage + 'A');

                html += '<tr><td>' + sesext_safe(elementId) + '</td><td>' + sesext_safe(element.element_type_desc) + '</td>';
                html += '<td>' + sesext_safe(element.status) + '</td>';
                html += '<td class="' + sesext_getStatusClass(element.status) + '">' + sesext_safe(element.status_desc) + '</td>';
                html += '<td>' + sesext_safe(element.prdfail) + '</td><td>' + sesext_safe(element.disabled) + '</td><td>' + sesext_safe(element.swap) + '</td>';
                html += '<td>' + extra.join(', ') + '</td></tr>';
            });

            html += '</tbody></table></div><br>';
        }

        $(targetContainer).append(html);
    }

    let openDeviceIds = {};

    async function sesext_loadData() {
        const cacheBust = `?v=${Date.now()}`;
        const basePath = '/plugins/sesmon-ext/json';
        const newContent = $('<div/>');

        $('[data-toggle-id]').each(function() {
            const targetId = '#' + $(this).data('toggle-id');
            if ($(targetId).is(':visible')) {
                openDeviceIds[targetId] = true;
            }
        });

        let res;
        try {
            res = await fetch(`/plugins/sesmon-ext/include/sesext_list.php${cacheBust}`);
        } catch (e) {
            console.error('Failed to load folder list:', e);
            return;
        }
        if (!res.ok) {
            console.error('Failed to load folder list:', res.status, res.statusText);
            return;
        }
        const folders = await res.json();

        const folderArray = [];
        $.each(folders, function(folderName, folderData) {
            if (folderData.parsed) {
                folderArray.push({ folderName: folderName, folderData: folderData });
            }
        });
        if (folderArray.length === 0) {
            $('#sesext-content').html("<i>There are currently no enclosure device reports available.</i>");
            return;
        }

        // which drive is in which bay (optional: without it the page shows what it always did)
        let bayData = {};
        try {
            const bayRes = await fetch(`/plugins/sesmon-ext/include/sesext_bays_json.php${cacheBust}`);
            if (bayRes.ok) { const j = await bayRes.json(); bayData = (j && !Array.isArray(j)) ? j : {}; }
        } catch (e) {
            console.warn('Failed to load the bay map:', e);
        }

        const devicePromises = folderArray.map(async ({ folderName, folderData }) => {
            // Device data
            let deviceRes;
            try {
                deviceRes = await fetch(`${basePath}/${folderName}/${folderData.parsed}${cacheBust}`);
            } catch (e) {
                console.error(`Failed to load device data for ${folderName}:`, e);
                return;
            }
            if (!deviceRes.ok) {
                console.error(`Failed to load device data for ${folderName}:`, deviceRes.status, deviceRes.statusText);
                return;
            }
            const data = await deviceRes.json();

            // Device alerts data
            const alerts = folderData.alerts || [];
            let alertDataArray = [];

            if (alerts.length > 0) {
                const alertPromises = alerts.map(async (alertFile) => {
                    try {
                        const alertRes = await fetch(`${basePath}/${folderName}/${alertFile}${cacheBust}`);
                        if (!alertRes.ok) {
                            throw new Error(alertRes.statusText || 'Alert fetch failed');
                        }
                        return await alertRes.json();
                    } catch (e) {
                        console.warn(`Failed to load alert ${alertFile} for ${folderName}:`, e);
                        return null;
                    }
                });

                const alertResults = await Promise.all(alertPromises);
                alertDataArray = alertResults.filter(a => a !== null);
            }

            return { folderName, data, alertDataArray, bayInfo: bayData[folderName] || null };
        });

        const results = (await Promise.all(devicePromises)).filter(r => r);

        results.sort(function(a, b) {
            return a.folderName.localeCompare(b.folderName, 'en', {
                numeric: true,
                sensitivity: 'base'
            });
        });

        sesext_last = results;
        sesext_render();
    }

    // draw the last data in the chosen view (also used when the view is switched, without fetching again)
    function sesext_render() {
        if (!sesext_last) return;
        const newContent = $('<div/>');

        $('[data-toggle-id]').each(function() {
            const targetId = '#' + $(this).data('toggle-id');
            if ($(targetId).is(':visible')) {
                openDeviceIds[targetId] = true;
            }
        });

        sesext_last.forEach(result => {
            sesext_buildDevice(result.folderName, result.data, result.alertDataArray, newContent, result.bayInfo);
        });
        // the pointer to Disk Location Next is worth showing next to a table that names drives (until it is dismissed)
        var namesDrives = sesext_last.some(function (r) { return r.bayInfo && Object.keys(r.bayInfo.bays).some(function (k) { return r.bayInfo.bays[k].drives.length > 0; }); });
        var dismissed = false; try { dismissed = localStorage.getItem('sesext_dl_dismissed') === '1'; } catch (e) {}
        $('#sesext-callout').toggle(sesext_view === 'friendly' && namesDrives && !dismissed);

        $('#sesext-content').html(newContent.html());

        $('.sesext-device-content').each(function() {
            const id = '#' + this.id;
            if (openDeviceIds[id]) {
                $(this).show();
                sesext_toggleChevron(id);
                delete openDeviceIds[id];
            } else {
                $(this).hide();
                sesext_toggleChevron(id);
            }
        });

        openDeviceIds = {};
    }

    function sesext_setUnit(u) {
        sesext_unit = u;
        try { localStorage.setItem('sesext_unit', u); } catch (e) {}
        $('.sesext-viewbar a[data-unit]').removeClass('active').filter('[data-unit="' + u + '"]').addClass('active');
        sesext_render();
    }

    function sesext_setView(v) {
        sesext_view = v;
        try { localStorage.setItem('sesext_view', v); } catch (e) {}
        $('.sesext-viewbar a[data-view]').removeClass('active').filter('[data-view="' + v + '"]').addClass('active');
        $('#sesext-unitbar').toggle(v === 'friendly'); // Raw shows the values exactly as sesmon reports them, in Celsius
        $('#sesext-viewhint').text(v === 'raw' ? 'Values exactly as sesmon reports them.' : 'Hover a status for what it means. Switch to Raw for the values as reported.');
        sesext_render();
    }

    $(document).ready(function() {
        $('.sesext-viewbar a[data-unit]').removeClass('active').filter('[data-unit="' + sesext_unit + '"]').addClass('active');
        sesext_setView(sesext_view);
        $(document).on('click', '.sesext-callout-close', function() { try { localStorage.setItem('sesext_dl_dismissed', '1'); } catch (e) {} $('#sesext-callout').hide(); });
        $(document).on('click', '.sesext-viewbar a[data-view]', function() { sesext_setView($(this).data('view')); });
        $(document).on('click', '.sesext-viewbar a[data-unit]', function() { sesext_setUnit($(this).data('unit')); });
        sesext_loadData();
        timers.sesext_loadData = setInterval(sesext_loadData, 15000);

        $(document).on('click', '[data-toggle-id]', function() {
            var targetId = '#' + $(this).data('toggle-id');
            $(targetId).toggle();
            sesext_toggleChevron(targetId);
        });
    });
} catch (error) {
    console.error('sesmon-ext devices error:', error);
}
</script>
